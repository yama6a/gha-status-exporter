{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "gha-status-exporter values",
    "type": "object",
    "properties": {
        "fullnameOverride": {
            "type": "string"
        },
        "global": {
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key.",
            "type": [
                "object",
                "null"
            ]
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "logLevel": {
            "type": "string"
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object"
        },
        "owner": {
            "type": "string"
        },
        "podAnnotations": {
            "type": "object"
        },
        "podMonitor": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "interval": {
                    "type": "string"
                },
                "labels": {
                    "type": "object"
                }
            }
        },
        "port": {
            "type": "integer"
        },
        "priorityClassName": {
            "type": "string"
        },
        "rateLimitReserve": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "scanInterval": {
            "type": "string"
        },
        "token": {
            "type": "object",
            "properties": {
                "secretKey": {
                    "type": "string"
                },
                "secretName": {
                    "type": "string"
                }
            }
        },
        "tolerations": {
            "type": "array"
        }
    },
    "additionalProperties": false
}
